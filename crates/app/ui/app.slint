import { Slider, HorizontalBox, VerticalBox, CheckBox, Button, GroupBox, ComboBox, ScrollView } from "std-widgets.slint";

export component AppWindow inherits Window {
    title: "SimPaint";
    preferred-width: 1400px;
    preferred-height: 860px;

    in property <image> canvas-texture <=> canvas-image.source;
    in property <length> canvas-width: 1024px;
    in property <length> canvas-height: 768px;
    in property <float> canvas-scale: 1.0;
    in property <[color]> swatches: [];
    in property <string> status: "";
    in property <float> frame-ms: 0;
    out property <float> pressure <=> pressure-slider.value;
    in property <[string]> brush-names: [];
    out property <int> brush-index <=> brush-choice.current-index;
    out property <float> brush-scale <=> size-slider.value;
    out property <float> brush-bristles <=> bristles-slider.value;
    out property <float> brush-stiffness <=> stiffness-slider.value;
    out property <float> brush-angle <=> angle-slider.value;
    out property <float> paint-load <=> load-slider.value;
    out property <float> paint-medium <=> medium-slider.value;
    out property <bool> show-bristles <=> bristles-toggle.checked;
    out property <bool> fluid-enabled <=> fluid-toggle.checked;
    out property <bool> recording <=> record-toggle.checked;
    out property <float> light-azimuth <=> azimuth-slider.value;
    out property <float> light-elevation <=> elevation-slider.value;
    out property <float> gloss <=> gloss-slider.value;
    in property <string> pen-status: "";

    callback pointer(kind: int, x: float, y: float);
    callback dip(index: int);
    callback brush-changed();
    callback paint-changed();
    callback clear();
    callback undo();
    callback save();
    callback dry();

    property <float> zoom: 1.0;
    property <length> pan-x: 0;
    property <length> pan-y: 0;

    forward-focus: keys;

    keys := FocusScope {
        key-pressed(event) => {
            if (event.text == "z" && (event.modifiers.meta || event.modifiers.control)) {
                root.undo();
                return accept;
            }
            return reject;
        }

        HorizontalLayout {
            viewport := Rectangle {
                background: #3a3a3a;
                clip: true;
                horizontal-stretch: 1;

                canvas-image := Image {
                    x: (viewport.width - self.width) / 2 + root.pan-x;
                    y: (viewport.height - self.height) / 2 + root.pan-y;
                    width: root.canvas-width * root.zoom;
                    height: root.canvas-height * root.zoom;
                }

                TouchArea {
                    pointer-event(event) => {
                        if (event.button != PointerEventButton.left) { return; }
                        if (event.kind == PointerEventKind.down) {
                            root.pointer(0, (self.mouse-x - canvas-image.x) / root.zoom / 1px, (self.mouse-y - canvas-image.y) / root.zoom / 1px);
                        } else if (event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel) {
                            root.pointer(2, (self.mouse-x - canvas-image.x) / root.zoom / 1px, (self.mouse-y - canvas-image.y) / root.zoom / 1px);
                        }
                    }
                    moved => {
                        if (self.pressed) {
                            root.pointer(1, (self.mouse-x - canvas-image.x) / root.zoom / 1px, (self.mouse-y - canvas-image.y) / root.zoom / 1px);
                        }
                    }
                    scroll-event(event) => {
                        if (event.modifiers.control || event.modifiers.meta) {
                            root.zoom = clamp(root.zoom * (1 + event.delta-y / 500px), 0.1, 16.0);
                        } else {
                            root.pan-x += event.delta-x;
                            root.pan-y += event.delta-y;
                        }
                        return accept;
                    }
                }
            }

            panel := Rectangle {
                width: 280px;
                background: #262626;

                ScrollView {
                    VerticalBox {
                    alignment: start;
                    spacing: 6px;

                    GroupBox {
                        title: "Palette";
                        HorizontalLayout {
                            spacing: 6px;
                            for swatch[index] in root.swatches: Rectangle {
                                width: 20px;
                                height: 20px;
                                background: swatch;
                                border-radius: 4px;
                                border-width: 1px;
                                border-color: #ffffff30;
                                TouchArea { clicked => { root.dip(index); } }
                            }
                        }
                    }

                    GroupBox {
                        title: "Brush";
                        VerticalLayout {
                            spacing: 2px;
                            brush-choice := ComboBox {
                                model: root.brush-names;
                                current-index: 1;
                                selected => { root.brush-changed(); }
                            }
                            Text { text: "Size ×" + round(size-slider.value * 100) / 100; }
                            size-slider := Slider { minimum: 0.4; maximum: 2.5; value: 1.0; released => { root.brush-changed(); } }
                            Text { text: "Bristles " + round(bristles-slider.value); }
                            bristles-slider := Slider { minimum: 20; maximum: 600; value: 200; released => { root.brush-changed(); } }
                            Text { text: "Stiffness " + round(stiffness-slider.value * 100) + "%"; }
                            stiffness-slider := Slider { minimum: 0; maximum: 1; value: 0.5; released => { root.brush-changed(); } }
                            Text { text: "Angle " + round(angle-slider.value) + "°"; }
                            angle-slider := Slider { minimum: 0; maximum: 180; value: 0; }
                            Text { text: "Pressure " + round(pressure-slider.value * 100) + "% (mouse)"; }
                            pressure-slider := Slider { minimum: 0.0; maximum: 1.0; value: 0.5; }
                        }
                    }

                    GroupBox {
                        title: "Paint";
                        VerticalLayout {
                            spacing: 2px;
                            Text { text: "Load " + round(load-slider.value * 100) + "%"; }
                            load-slider := Slider { minimum: 0.05; maximum: 1; value: 1; released => { root.paint-changed(); } }
                            Text { text: "Medium " + round(medium-slider.value * 100) + "%"; }
                            medium-slider := Slider { minimum: 0; maximum: 1; value: 0; released => { root.paint-changed(); } }
                        }
                    }

                    GroupBox {
                        title: "Light";
                        VerticalLayout {
                            spacing: 2px;
                            Text { text: "Direction " + round(azimuth-slider.value) + "°"; }
                            azimuth-slider := Slider { minimum: 0; maximum: 360; value: 225; }
                            Text { text: "Elevation " + round(elevation-slider.value) + "°"; }
                            elevation-slider := Slider { minimum: 10; maximum: 80; value: 40; }
                            Text { text: "Gloss " + round(gloss-slider.value * 100) + "%"; }
                            gloss-slider := Slider { minimum: 0; maximum: 1; value: 0.5; }
                        }
                    }

                    GroupBox {
                        title: "Simulation";
                        VerticalLayout {
                            spacing: 2px;
                            fluid-toggle := CheckBox { text: "Fluid"; checked: true; }
                            bristles-toggle := CheckBox { text: "Show bristles"; }
                            record-toggle := CheckBox { text: "Record scenario"; }
                        }
                    }

                    GroupBox {
                        title: "Canvas";
                        VerticalLayout {
                            spacing: 2px;
                            Button { text: "Undo (Cmd+Z)"; clicked => { root.undo(); } }
                            Button { text: "Dry"; clicked => { root.dry(); } }
                            Button { text: "Clear"; clicked => { root.clear(); } }
                            Button { text: "Save PNG"; clicked => { root.save(); } }
                        }
                    }

                    Text {
                        text: "Frame " + round(root.frame-ms * 10) / 10 + " ms";
                        width: 240px;
                        color: #aaaaaa;
                    }
                    Text {
                        text: root.pen-status;
                        width: 240px;
                        color: #aaaaaa;
                    }
                    Text {
                        text: root.status;
                        width: 240px;
                        wrap: word-wrap;
                        color: #aaaaaa;
                    }
                    }
                }
            }
        }
    }
}
