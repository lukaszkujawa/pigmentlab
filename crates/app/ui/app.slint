import { LineEdit, ScrollView } from "std-widgets.slint";

export global Theme {
    out property <color> window: #16181c;
    out property <color> viewport: #23262b;
    out property <color> panel: #1c1f24;
    out property <color> card: #24282e;
    out property <color> line: #30353c;
    out property <color> track: #353a42;
    out property <color> accent: #4f8cff;
    out property <color> accent-soft: #4f8cff33;
    out property <color> text: #e8eaed;
    out property <color> muted: #8d939c;
    out property <color> danger: #e5484d;
    out property <length> radius: 8px;
}

component SectionTitle inherits Text {
    color: Theme.muted;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 1px;
}

component Card inherits Rectangle {
    in property <string> title;
    background: Theme.card;
    border-radius: Theme.radius;
    VerticalLayout {
        padding: 14px;
        spacing: 12px;
        SectionTitle { text: root.title; }
        @children
    }
}

component ParamSlider {
    in property <string> label;
    in property <string> value-text;
    in property <float> minimum: 0;
    in property <float> maximum: 1;
    in-out property <float> value;
    callback released();

    function set-from(x: length) {
        root.value = clamp(root.minimum + (x - knob.width / 2) / (track.width - knob.width) * (root.maximum - root.minimum), root.minimum, root.maximum);
    }

    VerticalLayout {
        spacing: 4px;
        HorizontalLayout {
            Text { text: root.label; color: Theme.text; font-size: 13px; horizontal-stretch: 1; }
            Text { text: root.value-text; color: Theme.muted; font-size: 13px; horizontal-alignment: right; }
        }
        track := Rectangle {
            height: 18px;
            Rectangle { x: 0; y: 7px; height: 4px; width: 100%; border-radius: 2px; background: Theme.track; }
            Rectangle { x: 0; y: 7px; height: 4px; width: knob.x + knob.width / 2; border-radius: 2px; background: Theme.accent; }
            knob := Rectangle {
                y: 2px;
                width: 14px;
                height: 14px;
                border-radius: 7px;
                background: area.pressed ? Theme.accent : Theme.text;
                x: (root.value - root.minimum) / (root.maximum - root.minimum) * (track.width - self.width);
                drop-shadow-blur: 4px;
                drop-shadow-color: #00000080;
            }
            area := TouchArea {
                pointer-event(event) => {
                    if (event.kind == PointerEventKind.down) { root.set-from(self.mouse-x); }
                    if (event.kind == PointerEventKind.up) { root.released(); }
                }
                moved => { if (self.pressed) { root.set-from(self.mouse-x); } }
            }
        }
    }
}

component Toggle {
    in property <string> label;
    in-out property <bool> checked;
    height: 26px;
    HorizontalLayout {
        spacing: 10px;
        Text { text: root.label; color: Theme.text; font-size: 13px; vertical-alignment: center; horizontal-stretch: 1; }
        Rectangle {
            width: 36px;
            height: 20px;
            border-radius: 10px;
            background: root.checked ? Theme.accent : Theme.track;
            animate background { duration: 120ms; }
            Rectangle {
                y: 2px;
                x: root.checked ? 18px : 2px;
                width: 16px;
                height: 16px;
                border-radius: 8px;
                background: white;
                animate x { duration: 120ms; }
            }
        }
    }
    TouchArea { clicked => { root.checked = !root.checked; } }
}

component ToolButton inherits Rectangle {
    in property <string> label;
    in property <bool> danger;
    callback clicked;
    height: 30px;
    width: label.preferred-width + 24px;
    border-radius: 6px;
    background: area.has-hover ? Theme.track : Theme.card;
    border-width: 1px;
    border-color: Theme.line;
    label := Text {
        text: root.label;
        color: root.danger ? Theme.danger : Theme.text;
        font-size: 13px;
        vertical-alignment: center;
        horizontal-alignment: center;
    }
    area := TouchArea { clicked => { root.clicked(); } }
}

component PresetRow inherits Rectangle {
    in property <string> label;
    in property <bool> selected;
    callback clicked;
    height: 30px;
    border-radius: 6px;
    background: root.selected ? Theme.accent-soft : (area.has-hover ? Theme.track : transparent);
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        Text {
            text: root.label;
            color: root.selected ? Theme.text : Theme.muted;
            font-size: 13px;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
        Rectangle {
            width: 6px;
            height: 6px;
            y: (parent.height - self.height) / 2;
            border-radius: 3px;
            background: root.selected ? Theme.accent : transparent;
        }
    }
    area := TouchArea { clicked => { root.clicked(); } }
}

component BrushGauge inherits Rectangle {
    in property <float> fill;
    in property <color> paint;
    property <float> shown: root.fill;
    property <length> tuft-start: self.width * 178 / 260;
    property <length> tuft-length: self.width * 76 / 260;
    animate shown { duration: 220ms; easing: ease-out; }
    height: 64px;

    Path {
        width: root.width;
        height: root.height;
        viewbox-width: 260;
        viewbox-height: 64;
        commands: "M 6 29 C 40 26, 110 25, 152 24 L 152 40 C 110 39, 40 38, 6 35 C 2 34, 2 30, 6 29 Z";
        fill: @linear-gradient(180deg, #c48a57 0%, #9a6235 55%, #6e4122 100%);
        stroke: #00000040;
        stroke-width: 1px;
    }
    Path {
        width: root.width;
        height: root.height;
        viewbox-width: 260;
        viewbox-height: 64;
        commands: "M 150 21 L 180 19 L 180 45 L 150 43 Z";
        fill: @linear-gradient(180deg, #f1f3f6 0%, #b9bec6 40%, #7d838c 75%, #c4c8ce 100%);
        stroke: #00000050;
        stroke-width: 1px;
    }
    Path {
        width: root.width;
        height: root.height;
        viewbox-width: 260;
        viewbox-height: 64;
        commands: "M 158 20 L 158 44 M 164 20 L 164 44";
        stroke: #00000035;
        stroke-width: 1px;
    }

    tuft := Path {
        width: root.width;
        height: root.height;
        viewbox-width: 260;
        viewbox-height: 64;
        commands: "M 179 20 C 205 13, 236 18, 252 32 C 236 46, 205 51, 179 44 Z";
        fill: @linear-gradient(180deg, #ece0c4 0%, #d3c29c 60%, #b9a67c 100%);
        stroke: #00000040;
        stroke-width: 1px;
    }
    Rectangle {
        x: root.tuft-start;
        width: root.tuft-length * root.shown;
        height: root.height;
        clip: true;
        Path {
            x: -root.tuft-start;
            width: root.width;
            height: root.height;
            viewbox-width: 260;
            viewbox-height: 64;
            commands: "M 179 20 C 205 13, 236 18, 252 32 C 236 46, 205 51, 179 44 Z";
            fill: root.paint;
            stroke: root.paint.darker(30%);
            stroke-width: 1px;
        }
        Path {
            x: -root.tuft-start;
            width: root.width;
            height: root.height;
            viewbox-width: 260;
            viewbox-height: 64;
            commands: "M 186 23 C 206 18, 226 21, 238 27";
            stroke: #ffffff70;
            stroke-width: 2px;
        }
    }
}

component Swatch inherits Rectangle {
    in property <color> paint;
    in property <bool> active;
    callback clicked;
    width: 34px;
    height: 34px;
    border-radius: 17px;
    background: root.paint;
    border-width: root.active ? 3px : 1px;
    border-color: root.active ? Theme.accent : #ffffff26;
    drop-shadow-blur: area.has-hover ? 8px : 4px;
    drop-shadow-color: #00000090;
    Rectangle {
        x: 8px;
        y: 6px;
        width: 11px;
        height: 7px;
        border-radius: 4px;
        background: #ffffff55;
    }
    area := TouchArea { clicked => { root.clicked(); } }
}

component IconSwatch inherits Rectangle {
    in property <string> glyph;
    in property <string> icon;
    in property <bool> active;
    callback clicked;
    width: 34px;
    height: 34px;
    border-radius: 17px;
    background: root.active ? Theme.accent-soft : (area.has-hover ? Theme.track : transparent);
    border-width: 1px;
    border-color: root.active ? Theme.accent : Theme.line;
    Text {
        text: root.glyph;
        color: root.active ? Theme.text : Theme.muted;
        font-size: 17px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    Path {
        x: 9px;
        y: 9px;
        width: 16px;
        height: 16px;
        viewbox-width: 16;
        viewbox-height: 16;
        commands: root.icon;
        stroke: root.active ? Theme.text : Theme.muted;
        stroke-width: 1.6px;
    }
    area := TouchArea { clicked => { root.clicked(); } }
}

component ColourPicker {
    in-out property <float> hue: 20;
    in-out property <float> saturation: 0.8;
    in-out property <float> value: 0.8;
    in property <string> hex;
    out property <color> colour: Colors.hsv(root.hue, root.saturation, root.value);
    callback hex-entered(string);
    callback use-colour(color);

    VerticalLayout {
        spacing: 10px;
        field := Rectangle {
            height: 140px;
            border-radius: 6px;
            clip: true;
            background: Colors.hsv(root.hue, 1, 1);
            Rectangle { background: @linear-gradient(90deg, #ffffff 0%, #ffffff00 100%); }
            Rectangle { background: @linear-gradient(180deg, #00000000 0%, #000000 100%); }
            Rectangle {
                x: root.saturation * parent.width - 8px;
                y: (1 - root.value) * parent.height - 8px;
                width: 16px;
                height: 16px;
                border-radius: 8px;
                border-width: 2px;
                border-color: white;
                background: root.colour;
                drop-shadow-blur: 3px;
                drop-shadow-color: #000000a0;
            }
            TouchArea {
                function pick() {
                    root.saturation = clamp(self.mouse-x / self.width, 0, 1);
                    root.value = clamp(1 - self.mouse-y / self.height, 0, 1);
                }
                pointer-event(event) => { if (event.kind == PointerEventKind.down) { self.pick(); } }
                moved => { if (self.pressed) { self.pick(); } }
            }
        }
        hue-bar := Rectangle {
            height: 14px;
            border-radius: 7px;
            background: @linear-gradient(90deg, #ff0000 0%, #ffff00 16.67%, #00ff00 33.33%, #00ffff 50%, #0000ff 66.67%, #ff00ff 83.33%, #ff0000 100%);
            Rectangle {
                x: root.hue / 360 * parent.width - 7px;
                y: 0;
                width: 14px;
                height: 14px;
                border-radius: 7px;
                border-width: 2px;
                border-color: white;
                background: Colors.hsv(root.hue, 1, 1);
                drop-shadow-blur: 3px;
                drop-shadow-color: #000000a0;
            }
            TouchArea {
                function pick() { root.hue = clamp(self.mouse-x / self.width, 0, 0.9999) * 360; }
                pointer-event(event) => { if (event.kind == PointerEventKind.down) { self.pick(); } }
                moved => { if (self.pressed) { self.pick(); } }
            }
        }
        HorizontalLayout {
            spacing: 10px;
            Rectangle {
                width: 30px;
                height: 30px;
                border-radius: 15px;
                background: root.colour;
                border-width: 1px;
                border-color: #ffffff26;
            }
            hex-field := LineEdit {
                text: root.hex;
                font-size: 13px;
                horizontal-stretch: 1;
                accepted(text) => { root.hex-entered(text); }
            }
            ToolButton { label: "Use"; clicked => { root.use-colour(root.colour); } }
        }
    }
}

export component AppWindow inherits Window {
    title: "SimPaint";
    preferred-width: 1440px;
    preferred-height: 900px;
    background: Theme.window;

    in property <image> canvas-texture <=> canvas-image.source;
    in property <length> canvas-width: 1024px;
    in property <length> canvas-height: 768px;
    in property <float> canvas-scale: 1.0;
    in property <[color]> swatches: [];
    in property <int> active-swatch: 2;
    in property <float> brush-fill: 0;
    in property <color> brush-paint: #c0392b;
    in property <string> picker-hex: "";
    in-out property <bool> eyedropper: false;
    property <float> picker-hue: 20;
    property <float> picker-saturation: 0.8;
    property <float> picker-value: 0.8;
    property <color> picker-colour: Colors.hsv(self.picker-hue, self.picker-saturation, self.picker-value);
    property <int> swatch-columns: 6;
    property <length> swatch-cell: 42px;
    changed picker-colour => { root.picker-changed(self.picker-colour); }
    in property <string> status: "";
    in property <float> frame-ms: 0;
    in property <bool> pen-present: false;
    in property <string> pen-status: "";
    in property <[string]> brush-names: [];
    out property <float> pressure <=> pressure-slider.value;
    out property <int> brush-index: 1;
    out property <float> brush-scale <=> size-slider.value;
    in-out property <float> brush-bristles <=> bristles-slider.value;
    out property <float> brush-stiffness <=> stiffness-slider.value;
    out property <float> brush-angle <=> angle-slider.value;
    out property <float> paint-load <=> load-slider.value;
    out property <float> paint-medium <=> medium-slider.value;
    out property <float> canvas-tooth <=> tooth-slider.value;
    out property <bool> show-bristles <=> bristles-toggle.checked;
    out property <bool> levelling-enabled <=> levelling-toggle.checked;
    out property <bool> recording <=> record-toggle.checked;
    out property <float> light-azimuth <=> azimuth-slider.value;
    out property <float> light-elevation <=> elevation-slider.value;
    out property <float> gloss <=> gloss-slider.value;

    callback pointer(kind: int, x: float, y: float);
    callback dip(index: int);
    callback clean();
    callback use-colour(color);
    callback hex-entered(string);
    callback picker-changed(color);
    callback pick-colour(x: float, y: float);

    public function show-in-picker(colour: color) {
        root.picker-hue = colour.to-hsv().hue;
        root.picker-saturation = colour.to-hsv().saturation;
        root.picker-value = colour.to-hsv().value;
    }
    callback brush-selected(index: int);
    callback brush-adjusted();
    callback paint-changed();
    callback canvas-changed();
    callback clear();
    callback undo();
    callback save();
    callback dry();

    property <float> zoom: 1.0;
    property <length> pan-x: 0;
    property <length> pan-y: 0;

    forward-focus: keys;

    keys := FocusScope {
        key-pressed(event) => {
            if (event.text == "z" && (event.modifiers.meta || event.modifiers.control)) {
                root.undo();
                return accept;
            }
            return reject;
        }

        VerticalLayout {
            toolbar := Rectangle {
                height: 48px;
                background: Theme.panel;
                HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 16px;
                    spacing: 8px;
                    Text { text: "SimPaint"; color: Theme.text; font-size: 15px; font-weight: 700; vertical-alignment: center; }
                    Text { text: "oil"; color: Theme.muted; font-size: 12px; vertical-alignment: center; }
                    Rectangle { horizontal-stretch: 1; }
                    ToolButton { label: "Undo"; clicked => { root.undo(); } }
                    ToolButton { label: "Dry"; clicked => { root.dry(); } }
                    ToolButton { label: "Save PNG"; clicked => { root.save(); } }
                    ToolButton { label: "Clear"; danger: true; clicked => { root.clear(); } }
                }
                Rectangle { y: parent.height - 1px; height: 1px; width: 100%; background: Theme.line; }
            }

            HorizontalLayout {
                viewport := Rectangle {
                    background: Theme.viewport;
                    clip: true;
                    horizontal-stretch: 1;

                    Rectangle {
                        x: canvas-image.x;
                        y: canvas-image.y;
                        width: canvas-image.width;
                        height: canvas-image.height;
                        background: white;
                        drop-shadow-blur: 24px;
                        drop-shadow-color: #00000099;
                    }
                    canvas-image := Image {
                        x: (viewport.width - self.width) / 2 + root.pan-x;
                        y: (viewport.height - self.height) / 2 + root.pan-y;
                        width: root.canvas-width * root.zoom;
                        height: root.canvas-height * root.zoom;
                    }

                    TouchArea {
                        pointer-event(event) => {
                            if (event.button != PointerEventButton.left) { return; }
                            if (event.kind == PointerEventKind.down && root.eyedropper) {
                                root.eyedropper = false;
                                root.pick-colour((self.mouse-x - canvas-image.x) / root.zoom / 1px, (self.mouse-y - canvas-image.y) / root.zoom / 1px);
                                return;
                            }
                            if (event.kind == PointerEventKind.down) {
                                root.pointer(0, (self.mouse-x - canvas-image.x) / root.zoom / 1px, (self.mouse-y - canvas-image.y) / root.zoom / 1px);
                            } else if (event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel) {
                                root.pointer(2, (self.mouse-x - canvas-image.x) / root.zoom / 1px, (self.mouse-y - canvas-image.y) / root.zoom / 1px);
                            }
                        }
                        moved => {
                            if (self.pressed) {
                                root.pointer(1, (self.mouse-x - canvas-image.x) / root.zoom / 1px, (self.mouse-y - canvas-image.y) / root.zoom / 1px);
                            }
                        }
                        scroll-event(event) => {
                            if (event.modifiers.control || event.modifiers.meta) {
                                root.zoom = clamp(root.zoom * (1 + event.delta-y / 500px), 0.1, 16.0);
                            } else {
                                root.pan-x += event.delta-x;
                                root.pan-y += event.delta-y;
                            }
                            return accept;
                        }
                    }

                    Rectangle {
                        x: 12px;
                        y: parent.height - self.height - 12px;
                        width: zoom-label.preferred-width + 16px;
                        height: 24px;
                        border-radius: 6px;
                        background: #00000088;
                        zoom-label := Text {
                            text: round(root.zoom * 100) + "%";
                            color: Theme.text;
                            font-size: 12px;
                            vertical-alignment: center;
                            horizontal-alignment: center;
                        }
                    }
                }

                panel := Rectangle {
                    width: 312px;
                    background: Theme.panel;
                    Rectangle { x: 0; width: 1px; height: 100%; background: Theme.line; }

                    ScrollView {
                        content-width: self.visible-width;
                        VerticalLayout {
                            padding: 12px;
                            spacing: 10px;
                            alignment: start;

                            Card {
                                title: "BRUSH";
                                BrushGauge { fill: root.brush-fill; paint: root.brush-paint; }
                                HorizontalLayout {
                                    spacing: 8px;
                                    Text {
                                        text: root.brush-fill > 0.005 ? "Paint " + round(root.brush-fill * 100) + "%" : "Clean brush";
                                        color: Theme.muted;
                                        font-size: 13px;
                                        vertical-alignment: center;
                                        horizontal-stretch: 1;
                                    }
                                    ToolButton { label: "Clean"; clicked => { root.clean(); } }
                                }
                                Rectangle { height: 1px; background: Theme.line; }
                                Rectangle {
                                    height: ceil(root.brush-names.length / 2) * 32px - 2px;
                                    for name[index] in root.brush-names: PresetRow {
                                        x: mod(index, 2) * (parent.width + 4px) / 2;
                                        y: floor(index / 2) * 32px;
                                        width: (parent.width - 4px) / 2;
                                        label: name;
                                        selected: index == root.brush-index;
                                        clicked => { root.brush-index = index; root.brush-selected(index); }
                                    }
                                }
                                Rectangle { height: 1px; background: Theme.line; }
                                size-slider := ParamSlider { label: "Size"; minimum: 0.4; maximum: 2.5; value: 1.0; value-text: "×" + round(self.value * 100) / 100; released => { root.brush-adjusted(); } }
                                bristles-slider := ParamSlider { label: "Bristles"; minimum: 20; maximum: 600; value: 200; value-text: round(self.value); released => { root.brush-adjusted(); } }
                                stiffness-slider := ParamSlider { label: "Stiffness"; minimum: 0; maximum: 1; value: 0.5; value-text: round(self.value * 100) + "%"; released => { root.brush-adjusted(); } }
                                angle-slider := ParamSlider { label: "Angle"; minimum: 0; maximum: 180; value: 0; value-text: round(self.value) + "°"; }
                                pressure-slider := ParamSlider { label: root.pen-present ? "Pressure (pen)" : "Pressure"; minimum: 0; maximum: 1; value: 0.5; value-text: round(self.value * 100) + "%"; }
                            }

                            Card {
                                title: "PALETTE";
                                Rectangle {
                                    height: ceil((root.swatches.length + 2) / root.swatch-columns) * root.swatch-cell - 8px;
                                    for swatch[index] in root.swatches: Swatch {
                                        x: mod(index, root.swatch-columns) * root.swatch-cell;
                                        y: floor(index / root.swatch-columns) * root.swatch-cell;
                                        paint: swatch;
                                        active: index == root.active-swatch;
                                        clicked => { root.dip(index); }
                                    }
                                    IconSwatch {
                                        x: mod(root.swatches.length, root.swatch-columns) * root.swatch-cell;
                                        y: floor(root.swatches.length / root.swatch-columns) * root.swatch-cell;
                                        glyph: "+";
                                        clicked => { picker-popup.show(); }
                                    }
                                    IconSwatch {
                                        x: mod(root.swatches.length + 1, root.swatch-columns) * root.swatch-cell;
                                        y: floor((root.swatches.length + 1) / root.swatch-columns) * root.swatch-cell;
                                        icon: "M 2 14 L 4 14 L 10.5 7.5 M 2 14 L 2 12 L 8.5 5.5 M 7.5 4.5 L 11.5 8.5 M 9.5 6.5 L 12.5 3.5 C 13.5 2.5 14.5 3.5 13.5 4.5 L 10.5 7.5";
                                        active: root.eyedropper;
                                        clicked => { root.eyedropper = !root.eyedropper; }
                                    }
                                }
                                if root.eyedropper: Text {
                                    text: "Click the canvas to pick a colour";
                                    color: Theme.muted;
                                    font-size: 12px;
                                }
                                picker-popup := PopupWindow {
                                    x: -self.width - 24px;
                                    y: -140px;
                                    width: 280px;
                                    close-policy: PopupClosePolicy.close-on-click-outside;
                                    Rectangle {
                                        background: Theme.card;
                                        border-radius: Theme.radius;
                                        border-width: 1px;
                                        border-color: Theme.line;
                                        drop-shadow-blur: 24px;
                                        drop-shadow-color: #000000a0;
                                        VerticalLayout {
                                            padding: 14px;
                                            spacing: 12px;
                                            HorizontalLayout {
                                                SectionTitle { text: "MIX A COLOUR"; horizontal-stretch: 1; vertical-alignment: center; }
                                                IconSwatch { width: 24px; height: 24px; glyph: "×"; clicked => { picker-popup.close(); } }
                                            }
                                            ColourPicker {
                                                hue <=> root.picker-hue;
                                                saturation <=> root.picker-saturation;
                                                value <=> root.picker-value;
                                                hex: root.picker-hex;
                                                hex-entered(text) => { root.hex-entered(text); }
                                                use-colour(colour) => { root.use-colour(colour); picker-popup.close(); }
                                            }
                                        }
                                    }
                                }
                            }

                            Card {
                                title: "PAINT";
                                load-slider := ParamSlider { label: "Load"; minimum: 0.05; maximum: 1; value: 1; value-text: round(self.value * 100) + "%"; released => { root.paint-changed(); } }
                                medium-slider := ParamSlider { label: "Medium"; minimum: 0; maximum: 1; value: 0; value-text: round(self.value * 100) + "%"; released => { root.paint-changed(); } }
                            }

                            Card {
                                title: "CANVAS";
                                tooth-slider := ParamSlider { label: "Tooth"; minimum: 0; maximum: 2; value: 0.5; value-text: round(self.value * 100) / 100 + " px"; released => { root.canvas-changed(); } }
                            }

                            Card {
                                title: "LIGHT";
                                azimuth-slider := ParamSlider { label: "Direction"; minimum: 0; maximum: 360; value: 225; value-text: round(self.value) + "°"; }
                                elevation-slider := ParamSlider { label: "Elevation"; minimum: 10; maximum: 80; value: 40; value-text: round(self.value) + "°"; }
                                gloss-slider := ParamSlider { label: "Gloss"; minimum: 0; maximum: 1; value: 0.5; value-text: round(self.value * 100) + "%"; }
                            }

                            Card {
                                title: "SIMULATION";
                                levelling-toggle := Toggle { label: "Paint levelling"; checked: true; }
                                bristles-toggle := Toggle { label: "Show bristles"; }
                                record-toggle := Toggle { label: "Record scenario"; }
                            }
                        }
                    }
                }
            }

            statusbar := Rectangle {
                height: 28px;
                background: Theme.panel;
                Rectangle { y: 0; height: 1px; width: 100%; background: Theme.line; }
                HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 16px;
                    spacing: 24px;
                    Text { text: root.pen-status; color: Theme.muted; font-size: 12px; vertical-alignment: center; }
                    Text { text: root.status; color: Theme.muted; font-size: 12px; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                    Text { text: round(root.frame-ms * 10) / 10 + " ms"; color: Theme.muted; font-size: 12px; vertical-alignment: center; }
                }
            }
        }
    }
}
